# Chat History LanceDB Configuration

# Database path (local file system)
CHAT_HISTORY_DB_PATH=~/.chat-history-lancedb

# Embedding Provider: zhipu or volcengine
CHAT_HISTORY_EMBEDDING_PROVIDER=zhipu

# Zhipu AI (智谱AI) Configuration
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_EMBEDDING_MODEL=embeddings-2

# Volcano Engine (火山引擎) Configuration
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_API_SECRET=your_volcengine_api_secret_here
VOLCENGINE_EMBEDDING_MODEL=ep-20241201000000-xxxxx

# Vector dimension (1024 for Zhipu embeddings-2)
CHAT_HISTORY_VECTOR_DIMENSION=1024

# Search defaults
CHAT_HISTORY_SEARCH_LIMIT=10
CHAT_HISTORY_SEARCH_MIN_SCORE=0.5
